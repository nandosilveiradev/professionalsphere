datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         Int    @id @default(autoincrement())
  fullName   String
  email      String @unique
  password   String
  country    String
  nationalId String
  urlHash    String

  @@unique([fullName, urlHash], name: "fullName_urlHash")
}
